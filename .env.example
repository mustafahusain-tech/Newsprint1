# Copy to .env for local dev with `netlify dev` (never commit the real .env)
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your key is scoped to a specific workspace (the API returns a 400
# asking for anthropic-workspace-id). Find the ID in the Anthropic Console URL when
# viewing the workspace, or under the workspace's settings. Leave unset otherwise.
ANTHROPIC_WORKSPACE_ID=
REBUILD_TOKEN=pick-any-long-random-string
